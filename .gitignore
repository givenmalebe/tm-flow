# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# stray git backups
.git-backup-*/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit. API keys and database URLs live here.
.env
.env.*
!.env.example

# firebase
.firebase/
.firebaserc
firebase-debug.log
*-debug.log
ui-debug.log

# service account keys
*service-account*.json
*-key.json
google-services.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.pid

# local data
*.db
*.sqlite3
uploads/
!uploads/.gitkeep

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
*.log
dev.log
dev.out.log
test
prompt

server.log
